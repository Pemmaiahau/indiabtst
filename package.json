{
  "name": "btst-india",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "scan": "tsx scripts/scan.ts",
    "universe": "tsx scripts/universe.ts",
    "check": "tsx scripts/check-upload.ts",
